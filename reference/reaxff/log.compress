fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff maxiter 400
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.25

# cylindrical pillar leaves the corner ranks of the 4x4 xy grid near-empty; shift cuts in xy
balance         1.1 shift xy 20 1.05
