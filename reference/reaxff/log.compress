variable        L0 equal $(lz)
variable        L0 equal 93.171056337156102245
variable        strain equal (v_L0-lz)/v_L0
variable        scomp equal pzz*lx*ly/(PI*v_R0^2)*1.01325e-4
thermo_style    custom step time temp pe etotal lx ly lz v_strain pzz v_scomp
thermo_modify   flush yes
thermo          40

reset_timestep  0
dump            xyz all xyz ${ndump} traj_compress.xyz
dump            xyz all xyz 400 traj_compress.xyz
dump_modify     xyz element Ca Si O H
dump            cus all custom ${ndump} traj_compress.lammpstrj id type element x y z q
dump            cus all custom 400 traj_compress.lammpstrj id type element x y z q
dump_modify     cus element Ca Si O H sort id
fix             spec all reaxff/species 400 1 400 species.out
WARNING: Resetting reneighboring criteria to 'delay 0 every 400 check no' due to fix reaxff/species averaging of bond data (src/src/REAXFF/fix_reaxff_species.cpp:131)
fix             mom all momentum 100 linear 1 1 1 angular
fix             nvt all nvt temp ${T} ${T} 100.0
fix             nvt all nvt temp 10.0 ${T} 100.0
fix             nvt all nvt temp 10.0 10.0 100.0
fix             def all deform 1 z erate ${erate} remap x
fix             def all deform 1 z erate -1.0e-5 remap x
fix             bal all balance 1000 1.1 shift xy 20 1.05
run             ${ncomp}
run             120000

