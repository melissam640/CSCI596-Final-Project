# ---------------- Stage 2: thermalize at 10 K ----------------
reset_timestep  0
timestep        0.25
thermo          200
velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
velocity        all create 10.0 ${seed} mom yes rot yes dist gaussian
velocity        all create 10.0 482911 mom yes rot yes dist gaussian
fix             mom all momentum 100 linear 1 1 1 angular
dump            th all xyz ${ndump} traj_thermal.xyz
dump            th all xyz 400 traj_thermal.xyz
dump_modify     th element Ca Si O H

fix             nve all nve
fix             tb all temp/berendsen ${T} ${T} 25.0
fix             tb all temp/berendsen 10.0 ${T} 25.0
fix             tb all temp/berendsen 10.0 10.0 25.0
run             ${nber}
run             20000
