  restoring bond style harmonic from restart
  restoring angle style harmonic from restart
  10140 atoms
  2920 bonds
  1128 angles
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     1 = max # of 1-3 neighbors
     1 = max # of 1-4 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.001 seconds
  read_restart CPU = 0.011 seconds
include         /home1/anakano/tobermolite/clayff/inputs/ff.clayff
# ClayFF (Cygan, Liang, Kalinichev, JPCB 108, 1255, 2004) for tobermorite-11A pillar
# types: 1 cao  2 ca2  3 st  4 ob  5 nbo  6 oh  7 ho  8 ow  9 hw   (see build_clayff_data.py)
# LJ: epsilon = D0 (kcal/mol), sigma = R0 / 2^(1/6); Lorentz-Berthelot mixing; H has no LJ
pair_style      lj/cut/coul/long 10.0
pair_modify     mix arithmetic
kspace_style    pppm 1.0e-5
bond_style      harmonic
angle_style     harmonic
special_bonds   lj/coul 0.0 0.0 0.0

pair_coeff      1 1 5.0298e-6 5.56170     # cao  octahedral Ca (intralayer)
pair_coeff      2 2 0.1000    2.87199     # ca2  aqueous Ca2+ (interlayer)
pair_coeff      3 3 1.8405e-6 3.30203     # st   tetrahedral Si
pair_coeff      4 4 0.1554    3.16554     # ob   bridging O
pair_coeff      5 5 0.1554    3.16554     # nbo  non-bridging O
pair_coeff      6 6 0.1554    3.16554     # oh   silanol O
pair_coeff      7 7 0.0       0.0         # ho   silanol H
pair_coeff      8 8 0.1554    3.16554     # ow   water O (flexible SPC)
pair_coeff      9 9 0.0       0.0         # hw   water H

bond_coeff      1 554.1349 1.0            # O-H (water and hydroxyl)
angle_coeff     1 45.7696 109.47          # H-O-H (water)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.5

variable        L0 equal $(lz)
variable        L0 equal 88.449244321285164006
variable        strain equal (v_L0-lz)/v_L0
variable        scomp equal pzz*lx*ly/(PI*v_R0^2)*1.01325e-4
thermo_style    custom step time temp pe etotal ebond eangle lz v_strain pzz v_scomp
thermo_modify   flush yes
thermo          20

reset_timestep  0
dump            xyz all xyz ${ndump} traj_compress.xyz
dump            xyz all xyz 200 traj_compress.xyz
dump_modify     xyz element Ca Ca Si O O O H O H
dump            cus all custom ${ndump} traj_compress.lammpstrj id mol type element x y z q
dump            cus all custom 200 traj_compress.lammpstrj id mol type element x y z q
dump_modify     cus element Ca Ca Si O O O H O H sort id
fix             mom all momentum 100 linear 1 1 1 angular
fix             nvt all nvt temp ${T} ${T} 100.0
fix             nvt all nvt temp 10.0 ${T} 100.0
fix             nvt all nvt temp 10.0 10.0 100.0
Resetting global fix info from restart file:
  fix style: nvt, fix ID: nvt
fix             def all deform 1 z erate ${erate} remap x
fix             def all deform 1 z erate -1.0e-5 remap x
run             ${ncomp}
run             60000
