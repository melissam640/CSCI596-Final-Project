# Tobermorite-11A pillar, ClayFF: uniaxial compression along z at 1%/ps, 10 K, from thermal.restart
# Same strain rate and final strain as ../../inputs/in.compress (ReaxFF); 0.5 fs timestep.

variable T      index 10.0
variable ncomp  index 60000       # 30 ps -> 30% strain
variable erate  index -1.0e-5     # 1/fs  (= -1%/ps, engineering)
variable R0     index 20.35       # bulk-density equivalent radius (A) for stress normalization
variable ndump  index 200         # 200 x 0.5 fs = 100 fs

processors      2 2 8             # 2x2 xy cut through the pillar axis keeps ranks balanced
read_restart    thermal.restart
Reading restart file ...
  restart file = 30 Sep 2026, LAMMPS = 30 Sep 2026
  restoring atom style full from restart
  orthogonal box = (0 0 2.6153778) to (120 120 91.064622)
