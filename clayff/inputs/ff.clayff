# ClayFF (Cygan, Liang, Kalinichev, JPCB 108, 1255, 2004) for tobermorite-11A pillar
# types: 1 cao  2 ca2  3 st  4 ob  5 nbo  6 oh  7 ho  8 ow  9 hw   (see build_clayff_data.py)
# LJ: epsilon = D0 (kcal/mol), sigma = R0 / 2^(1/6); Lorentz-Berthelot mixing; H has no LJ
pair_style      lj/cut/coul/long 10.0
pair_modify     mix arithmetic
kspace_style    pppm 1.0e-5
bond_style      harmonic
angle_style     harmonic
special_bonds   lj/coul 0.0 0.0 0.0

pair_coeff      1 1 5.0298e-6 5.56170     # cao  octahedral Ca (intralayer)
pair_coeff      2 2 0.1000    2.87199     # ca2  aqueous Ca2+ (interlayer)
pair_coeff      3 3 1.8405e-6 3.30203     # st   tetrahedral Si
pair_coeff      4 4 0.1554    3.16554     # ob   bridging O
pair_coeff      5 5 0.1554    3.16554     # nbo  non-bridging O
pair_coeff      6 6 0.1554    3.16554     # oh   silanol O
pair_coeff      7 7 0.0       0.0         # ho   silanol H
pair_coeff      8 8 0.1554    3.16554     # ow   water O (flexible SPC)
pair_coeff      9 9 0.0       0.0         # hw   water H

bond_coeff      1 554.1349 1.0            # O-H (water and hydroxyl)
angle_coeff     1 45.7696 109.47          # H-O-H (water)
