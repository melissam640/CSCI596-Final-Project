# Tobermorite-11A pillar (axis = crystal c = z), ClayFF: relaxation + thermalization at 10 K
# Same atoms and protocol as ../../inputs/in.equil (ReaxFF), but fully periodic box with
# ~75 A of vacuum around the pillar in x,y so that PPPM can be used.
# Produces relaxed.data, thermal.restart, traj_thermal.xyz.  Follow with in.compress.

variable T      index 10.0
variable seed   index 482911
variable nmin1  index 5000        # CG iterations, atoms only (fixed box; Lz relaxed later by NPT)
variable nber   index 10000       # 5 ps Berendsen T at fixed box (drains relaxation heat)
variable nnpt   index 20000       # 10 ps Nose-Hoover NPT(z)
variable nnvt   index 10000       # 5 ps Nose-Hoover NVT
variable R0     index 20.35       # bulk-density equivalent radius (A) for stress normalization
variable ndump  index 200         # 200 x 0.5 fs = 100 fs

units           real
atom_style      full
boundary        p p p
processors      2 2 8             # 2x2 xy cut through the pillar axis keeps ranks balanced
read_data       pillar_clayff.data
include         /home1/anakano/tobermolite/clayff/inputs/ff.clayff
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# engineering axial stress (GPa, compression positive) = total virial_zz / (Lz * pi R0^2)
variable        scomp equal pzz*lx*ly/(PI*v_R0^2)*1.01325e-4
thermo_style    custom step time temp pe etotal ebond eangle ecoul elong lz pzz v_scomp
thermo_modify   flush yes

# ---------------- Stage 1: structural relaxation ----------------
thermo          50
min_style       cg
minimize        1.0e-10 1.0e-3 ${nmin1} $(2*v_nmin1)
write_data      relaxed.data

# ---------------- Stage 2: thermalize at 10 K ----------------
reset_timestep  0
timestep        0.5
thermo          100
velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
fix             mom all momentum 100 linear 1 1 1 angular
dump            th all xyz ${ndump} traj_thermal.xyz
dump_modify     th element Ca Ca Si O O O H O H

fix             nve all nve
fix             tb all temp/berendsen ${T} ${T} 25.0
run             ${nber}
unfix           tb
unfix           nve

fix             npt all npt temp ${T} ${T} 100.0 z 0.0 0.0 1000.0
run             ${nnpt}
unfix           npt
fix             nvt all nvt temp ${T} ${T} 100.0
run             ${nnvt}
write_restart   thermal.restart
