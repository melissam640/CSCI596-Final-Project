# Tobermorite-11A pillar, ClayFF: uniaxial compression along z at 1%/ps, 10 K, from thermal.restart
# Same strain rate and final strain as ../../inputs/in.compress (ReaxFF); 0.5 fs timestep.

variable T      index 10.0
variable ncomp  index 60000       # 30 ps -> 30% strain
variable erate  index -1.0e-5     # 1/fs  (= -1%/ps, engineering)
variable R0     index 20.35       # bulk-density equivalent radius (A) for stress normalization
variable ndump  index 200         # 200 x 0.5 fs = 100 fs

processors      2 2 8             # 2x2 xy cut through the pillar axis keeps ranks balanced
read_restart    thermal.restart
include         /home1/anakano/tobermolite/clayff/inputs/ff.clayff
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.5

variable        L0 equal $(lz)
variable        strain equal (v_L0-lz)/v_L0
variable        scomp equal pzz*lx*ly/(PI*v_R0^2)*1.01325e-4
thermo_style    custom step time temp pe etotal ebond eangle lz v_strain pzz v_scomp
thermo_modify   flush yes
thermo          20

reset_timestep  0
dump            xyz all xyz ${ndump} traj_compress.xyz
dump_modify     xyz element Ca Ca Si O O O H O H
dump            cus all custom ${ndump} traj_compress.lammpstrj id mol type element x y z q
dump_modify     cus element Ca Ca Si O O O H O H sort id
fix             mom all momentum 100 linear 1 1 1 angular
fix             nvt all nvt temp ${T} ${T} 100.0
fix             def all deform 1 z erate ${erate} remap x
run             ${ncomp}
write_restart   compressed.restart
write_data      compressed.data
